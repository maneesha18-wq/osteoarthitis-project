# ==========================================
# KneeAI Environment Configuration Template
# Copy this file to .env or .env.local
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==========================================

# ------------------------------------------
# Frontend Environment (Next.js)
# ------------------------------------------
# Public URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth & Database (Client-side safe public keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ------------------------------------------
# Backend Environment (FastAPI)
# ------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Model Configuration
MODEL_DIR=ml/artifacts
MODEL_PATH=ml/artifacts/mobilenetv2_knee_kl.keras
MODEL_TYPE=mobilenetv2
DEVICE=cpu

# Supabase Server-side (Optional verification)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Upload limits (bytes) - 10MB
MAX_UPLOAD_SIZE=10485760
